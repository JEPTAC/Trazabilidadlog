rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return userDoc().role; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && role() in ['admin', 'gerencia'];
    }

    match /cases/{caseId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && role() == 'admin';
    }

    match /case_events/{eventId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
  }
}
